import hashlib
import json
import os
import sys
import unicodedata
from pathlib import Path

import spacy
from jamdict import Jamdict
from pydantic import BaseModel
from google import genai
from google.genai import types
ACTIVE_MODEL = "gemini-2.5-pro"
#ACTIVE_MODEL = "gemini-2.5-flash"
USE_TRANSLATION_CACHE = True

jam = Jamdict()
translation_cache = {}
reading_cache = {}
nlp = spacy.load("ja_ginza")

BASE_DIR = Path(__file__).resolve().parent
JLPT_DIR = BASE_DIR / "jlpt"


class SentenceTranslation(BaseModel):
    japanese: str
    translation: str


class ArticleTranslation(BaseModel):
    sentences: list[SentenceTranslation]


def article_cache_file(full_article: str) -> Path:
    digest = hashlib.sha256(full_article.encode("utf-8")).hexdigest()[:16]
    return BASE_DIR / f"translation_cache_{digest}.json"


def save_translation_cache(full_article: str, article_translation: ArticleTranslation) -> None:
    cache_path = article_cache_file(full_article)
    with open(cache_path, \"w\", encoding=\"utf-8\") as f:
        json.dump(article_translation.model_dump(), f, ensure_ascii=False, indent=2)


def load_translation_cache(full_article: str) -> ArticleTranslation | None:
    cache_path = article_cache_file(full_article)
    if not cache_path.exists():
        return None
    try:
        with open(cache_path, \"r\", encoding=\"utf-8\") as f:
            data = json.load(f)
            return ArticleTranslation(**data)
    except Exception:
        return None


def get_article_translation(full_article: str) -> ArticleTranslation:
    if USE_TRANSLATION_CACHE:
        cached = load_translation_cache(full_article)
        if cached:
            print("Loaded translation from cache.")
            return cached

    print("Requesting translation from Gemini...")
    client = genai.Client()
    
    prompt = (
        "Translate the following Japanese NHK Easy news article into English, "
        "sentence by sentence. Keep sentence structure closely aligned for language learners.\\n\\n"
        f"{full_article}"
    )

    response = client.models.generate_content(
        model=ACTIVE_MODEL,
        contents=prompt,
        config=types.GenerateContentConfig(
            response_mime_type="application/json",
            response_schema=ArticleTranslation,
            temperature=0.1,
        ),
    )
    
    # Parse and validate structure
    result_dict = json.loads(response.text)
    article_translation = ArticleTranslation(**result_dict)
    
    if USE_TRANSLATION_CACHE:
        save_translation_cache(full_article, article_translation)
        
    return article_translation


def load_jlpt_set(level_str):
    """Loads vocabulary set for a given level (n5, n4, n3, n2, n1)"""
    file_path = JLPT_DIR / f"{level_str}.txt"
    if not file_path.exists():
        return set()
    with open(file_path, "r", encoding="utf-8") as f:
        return {line.strip() for line in f if line.strip()}


# Pre-load JLPT lists
jlpt_data = {
    "n5": load_jlpt_set("n5"),
    "n4": load_jlpt_set("n4"),
    "n3": load_jlpt_set("n3"),
    "n2": load_jlpt_set("n2"),
    "n1": load_jlpt_set("n1")
}


def get_jlpt_level(word):
    for level in ["n5", "n4", "n3", "n2", "n1"]:
        if word in jlpt_data[level]:
            return level
    return "unknown"


def is_katakana(text):
    return all(unicodedata.name(char).startswith("KATAKANA") for char in text if char.strip())


def is_hiragana(text):
    return all(unicodedata.name(char).startswith("HIRAGANA") for char in text if char.strip())


def clean_reading(reading):
    # Ginza outputs readings in katakana; convert to hiragana for normal dictionary use
    if not reading:
        return ""
    return "".join(chr(ord(c) - 96) if "ァ" <= c <= "ヶ" else c for c in reading)


def build_sentence_tokens(doc):
    tokens = []

    for token in doc:
        # Check if contains Japanese characters (Kanji, Hiragana, Katakana)
        is_japanese = any(
            "CJK UNIFIED IDEOGRAPH" in unicodedata.name(c) or
            "HIRAGANA" in unicodedata.name(c) or
            "KATAKANA" in unicodedata.name(c)
            for c in token.text
        )

        has_kanji = any("CJK UNIFIED IDEOGRAPH" in unicodedata.name(c) for c in token.text)

        # Get reading and lemma
        reading = clean_reading(token.morph.get("Reading"))
        reading = reading[0] if isinstance(reading, list) and reading else reading
        
        base = token.lemma_
        base_reading = ""
        
        # Try to infer lemma reading via jamdict cache or lookup
        if has_kanji and is_japanese:
            if base in reading_cache:
                base_reading = reading_cache[base]
            else:
                res = jam.lookup(base)
                if res.entries and res.entries[0].kana_forms:
                    base_reading = str(res.entries[0].kana_forms[0])
                    reading_cache[base] = base_reading

        # Jamdict lookup for word translation
        translation = ""
        if is_japanese and not token.is_stop and token.pos_ not in ["PUNCT", "SYM", "NUM"]:
            res = jam.lookup(base)
            if res.entries:
                senses = res.entries[0].senses
                if senses:
                    # FIX: Use singular 'sense' inside the generator to avoid TypeError
                    translation = "; ".join(sense.gloss[0].text for sense in senses[:2] if sense.gloss)

        level = get_jlpt_level(base)

        tokens.append({
            "surface": token.text,
            "reading": reading if has_kanji else "",
            "base": base,
            "base_reading": base_reading,
            "translation": translation or None,
            "level": level,
            "has_kanji": has_kanji,
            "is_japanese": is_japanese,
            "is_katakana": is_katakana(token.text),
            "is_hiragana": is_hiragana(token.text),
            "is_selectable": is_japanese and token.pos_ not in ["PUNCT", "SYM"],
            "grammar_label": "",
            "grammar_meaning": "",
            "is_grammar": False
        })

    return tokens

def build_sentences(translation_data, title_jp="", title_en=""):
    sentences = []

    for i, entry in enumerate(translation_data.get("sentences", [])):
        jp_text = entry["japanese"]
        en_text = entry.get("translation", "")

        doc = nlp(jp_text)
        tokens = build_sentence_tokens(doc)

        # Sentence 0 (first element parsed from HTML) is always the title
        is_title = (i == 0) or (jp_text == title_jp) or (en_text == title_en)

        sentences.append({
            "sentence_id": i,
            "jp": jp_text,
            "en": en_text,
            "is_title": is_title,
            "tokens": tokens,
        })

    return sentences


def load_article_text(path):
    with open(path, \"r\", encoding=\"utf-8\") as f:
        return f.read().strip()


def main():
    if len(sys.argv) < 3:
        print("Usage: python main.py <article_txt_or_html> <output_json>")
        sys.exit(1)

    article_path = sys.argv[1]
    output_path = sys.argv[2]

    full_article = load_article_text(article_path)
    translation_data = get_article_translation(full_article).model_dump()

    sentence_entries = translation_data.get("sentences", [])
    title = sentence_entries[0]["japanese"] if sentence_entries else ""
    title_en = sentence_entries[0].get("translation", "") if sentence_entries else ""

    output = {
        \"title\": title,
        \"title_en\": title_en,
        \"sentences\": build_sentences(translation_data, title_jp=title, title_en=title_en),
    }

    with open(output_path, \"w\", encoding=\"utf-8\") as f:
        json.dump(output, f, ensure_ascii=False, indent=2)

    print(f"Bilingual analysis JSON generated successfully at {output_path}")


if __name__ == "__main__":
    main()
