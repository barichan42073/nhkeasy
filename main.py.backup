import hashlib
import json
import os
import sys
import unicodedata
from pathlib import Path

import spacy
from jamdict import Jamdict
from pydantic import BaseModel
from google import genai
from google.genai import types

ACTIVE_MODEL = "gemini-2.5-pro"
# ACTIVE_MODEL = "gemini-2.5-flash"
USE_TRANSLATION_CACHE = True

jam = Jamdict()
translation_cache = {}
reading_cache = {}
nlp = spacy.load("ja_ginza")

BASE_DIR = Path(__file__).resolve().parent
JLPT_DIR = BASE_DIR / "jlpt"


class SentenceTranslation(BaseModel):
    japanese: str
    translation: str


class ArticleTranslation(BaseModel):
    sentences: list[SentenceTranslation]


class TermJLPTClassification(BaseModel):
    term: str
    jlpt_level: str  # Expected: "N1", "N2", "N3", "N4", "N5", or "Advanced"


class BatchJLPTResponse(BaseModel):
    classifications: list[TermJLPTClassification]


def article_cache_file(full_article: str) -> Path:
    digest = hashlib.sha256(full_article.encode("utf-8")).hexdigest()[:16]
    return BASE_DIR / f"translation_cache_{digest}.json"


def save_translation_cache(full_article: str, article_translation: ArticleTranslation) -> None:
    cache_path = article_cache_file(full_article)
    with open(cache_path, "w", encoding="utf-8") as f:
        json.dump(article_translation.model_dump(), f, ensure_ascii=False, indent=2)


def load_translation_cache(full_article: str) -> ArticleTranslation | None:
    cache_path = article_cache_file(full_article)
    if not cache_path.exists():
        return None
    try:
        with open(cache_path, "r", encoding="utf-8") as f:
            data = json.load(f)
        return ArticleTranslation(**data)
    except Exception as e:
        print(f"Warning: Failed to load translation cache: {e}")
        return None


def load_vocab_db():
    vocab_db = {}
    if not JLPT_DIR.exists():
        print(f"Warning: JLPT folder non-existent: {JLPT_DIR}")
        return vocab_db

    for json_file in JLPT_DIR.glob("term_meta_bank_*.json"):
        try:
            with open(json_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                for entry in data:
                    if len(entry) >= 3 and entry[1] == "jlpt":
                        term = entry[0]
                        val = entry[2]
                        if isinstance(val, str) and val.startswith("n"):
                            level = f"N{val[1:]}"
                        elif isinstance(val, int):
                            level = f"N{val}"
                        else:
                            level = str(val)
                        vocab_db[term] = level
        except Exception as e:
            print(f"Error reading {json_file}: {e}")

    return vocab_db


VOCAB_DB = load_vocab_db()


def normalize_japanese(text):
    return unicodedata.normalize("NFKC", text).strip()


def get_translation_client():
    api_key = os.getenv("GEMINI_API_KEY")
    if not api_key:
        raise ValueError("GEMINI_API_KEY environment variable is not set")
    return genai.Client(api_key=api_key)


def get_article_translation(full_article: str) -> ArticleTranslation:
    if USE_TRANSLATION_CACHE:
        cached = load_translation_cache(full_article)
        if cached is not None:
            print("Using cached full article translation...")
            return cached

    client = get_translation_client()

    prompt = f"""
You are a professional Japanese to English translator specializing in NHK News articles.
Translate the following Japanese news article sentence by sentence.

Instructions:
1. Divide the article logically by sentence or complete thought unit.
2. Provide a clear, natural English translation for each sentence.
3. Keep the exact Japanese text corresponding to each translation segment.
4. Do NOT drop, reorder, or merge unrelated sentences.

Article:
{full_article}
"""

    response = client.models.generate_content(
        model=ACTIVE_MODEL,
        contents=prompt,
        config=types.GenerateContentConfig(
            response_mime_type="application/json",
            response_schema=ArticleTranslation,
        ),
    )

    result: ArticleTranslation = response.parsed

    if USE_TRANSLATION_CACHE and result:
        save_translation_cache(full_article, result)

    return result


def is_kanji_compound(text: str) -> bool:
    """Checks if token contains at least one Kanji character."""
    return any('\u4e00' <= char <= '\u9fff' for char in text)


def classify_unknown_terms_with_ai(terms: list[str]) -> dict[str, str]:
    """Queries Gemini API in a single batch to estimate JLPT levels for missing terms."""
    if not terms:
        return {}

    client = get_translation_client()

    prompt = f"""
Analyze the following Japanese kanji terms/compounds that were missing from standard JLPT dictionary banks.
For each term, estimate its appropriate JLPT level (N1, N2, N3, N4, or N5). 
If it is an advanced or specialized news/weather term beyond standard JLPT (such as 酷暑日 or 熱中症), classify it as "N1" or "Advanced".

Terms to classify:
{json.dumps(terms, ensure_ascii=False)}
"""

    try:
        response = client.models.generate_content(
            model=ACTIVE_MODEL,
            contents=prompt,
            config=types.GenerateContentConfig(
                response_mime_type="application/json",
                response_schema=BatchJLPTResponse,
            ),
        )
        parsed: BatchJLPTResponse = response.parsed
        return {item.term: item.jlpt_level for item in parsed.classifications}
    except Exception as e:
        print(f"Warning: Failed to fetch AI JLPT levels: {e}")
        return {}


def expand_lookup_forms(base_form, surface):
    forms = []
    for f in [base_form, surface]:
        if f and f not in forms:
            forms.append(f)
            norm = normalize_japanese(f)
            if norm not in forms:
                forms.append(norm)
    return forms


def get_word_level(surface, base_form):
    for form in expand_lookup_forms(base_form, surface):
        if form in VOCAB_DB:
            return VOCAB_DB[form]
    return "unknown"


def translate_lemma(lemma, surface=""):
    if lemma in translation_cache:
        return translation_cache[lemma]

    for term in [lemma, surface]:
        if not term:
            continue
        res = jam.lookup(term)
        for entry in res.entries:
            meanings = []
            for sense in entry.senses:
                glosses = [g.text for g in sense.gloss if g.text]
                if glosses:
                    meanings.append(", ".join(glosses))
            if meanings:
                result = " / ".join(meanings[:2])
                translation_cache[lemma] = result
                return result

    translation_cache[lemma] = ""
    return ""


def get_reading(lemma, surface=""):
    key = (lemma, surface)
    if key in reading_cache:
        return reading_cache[key]

    for term in [surface, lemma]:
        if not term:
            continue
        res = jam.lookup(term)
        for entry in res.entries:
            for kana in entry.kana_forms:
                if kana.text:
                    reading_cache[key] = kana.text
                    return kana.text

    reading_cache[key] = ""
    return ""


def build_sentence_tokens(doc):
    tokens = []

    for token in doc:
        text = token.text
        lemma = token.lemma_ if token.lemma_ else text
        reading = get_reading(lemma, text)
        translation = translate_lemma(lemma, text)
        jlpt_level = get_word_level(text, lemma)

        tokens.append({
            "text": text,
            "lemma": lemma,
            "reading": reading,
            "pos": token.pos_,
            "pos_detail": token.tag_,
            "jlpt_level": jlpt_level,
            "translation": translation,
            "is_grammar": False
        })

    return tokens


def build_sentences(translation_data):
    sentences = []
    unknown_kanji_terms = set()

    for i, entry in enumerate(translation_data.get("sentences", [])):
        jp_text = entry["japanese"]
        en_text = entry.get("translation", "")

        doc = nlp(jp_text)
        tokens = build_sentence_tokens(doc)

        # Collect unknown terms containing Kanji
        for t in tokens:
            if t["jlpt_level"] == "unknown" and is_kanji_compound(t["text"]):
                unknown_kanji_terms.add(t["text"])

        sentences.append({
            "sentence_id": i,
            "jp": jp_text,
            "en": en_text,
            "is_title": False,
            "tokens": tokens,
        })

    # AI Fallback: Query Gemini in batch for all unknown Kanji terms
    if unknown_kanji_terms:
        print(f"Classifying {len(unknown_kanji_terms)} unknown kanji terms via Gemini AI...")
        ai_levels = classify_unknown_terms_with_ai(list(unknown_kanji_terms))

        # Update matching tokens across all sentences
        for sentence in sentences:
            for token in sentence["tokens"]:
                if token["text"] in ai_levels:
                    token["jlpt_level"] = ai_levels[token["text"]]

    return sentences


def load_article_text(path):
    with open(path, "r", encoding="utf-8") as f:
        return f.read().strip()


def main():
    if len(sys.argv) < 3:
        print("Usage: python main.py <article_txt> <output_json>")
        sys.exit(1)

    article_path = sys.argv[1]
    output_path = sys.argv[2]

    full_article = load_article_text(article_path)
    translation_data = get_article_translation(full_article).model_dump()

    sentence_entries = translation_data.get("sentences", [])
    title = sentence_entries[0]["japanese"] if sentence_entries else ""
    title_en = sentence_entries[0].get("translation", "") if sentence_entries else ""

    output = {
        "title": title,
        "title_en": title_en,
        "sentences": build_sentences(translation_data)
    }

    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(output, f, ensure_ascii=False, indent=2)

    print(f"Successfully generated JSON output: {output_path}")


if __name__ == "__main__":
    main()
